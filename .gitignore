.claude/

dist/
node_modules/

# Python virtual environments (server/paddleocr/, scripts/fetch-paddle-models.py
# throwaway venvs like .venv-fetch, etc.) — matches at any nesting depth.
.venv/
.venv-*/
venv/

# ONNX models — downloaded/converted locally, see extension/models/README.md
extension/models/*.onnx
extension/models/*.bak
__pycache__/

# Benchmark corpus — local fixture images/manifest/GT, see extension/bench/README.md
# (corpus.json.example and the GT schema docs stay committed)
extension/bench/fixtures/*
!extension/bench/fixtures/corpus.json.example
